# Canonical local environment template for this monorepo.
# Copy this file to .env at the repository root and fill machine-specific paths
# and private credentials there. Do not commit .env or real secrets.
#
# Precedence:
# 1. Existing OS/process environment variables win.
# 2. Repo-root .env fills missing values.
# 3. Deprecated app-local .env files may fill missing values only temporarily.
# 4. Safe code defaults apply last.


###############################################################################
# Shared/local paths
###############################################################################

# Optional. Semicolon-separated folders the browser UI may read/write through
# backend file tools.
# ECOMMERCE_FILE_ROOTS=C:\Users\user\Downloads;C:\Exports;output

# Optional. Semicolon-separated artifact roots for monitoring run outputs.
# ECOMMERCE_ARTIFACT_ROOTS=D:\Ecommerce\output\ecommerce\monitoring\runs


###############################################################################
# Ecommerce API
###############################################################################

# Optional unless using Catalog, Source URL Agent, Price Monitoring, alerts,
# observations, or history. Native Windows PostgreSQL local-development default:
ECOMMERCE_DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@127.0.0.1:5432/ecommerce

# Optional local CSV/path overrides.
# ECOMMERCE_SOURCE_CATA_PATH=C:\path\to\sourceCata.csv
# ECOMMERCE_PRICE_IGNORE_PATH=C:\path\to\price_ignore.csv
# ECOMMERCE_SOURCE_CAPTURE_ARTIFACT_DIR=output/source_capture/artifacts

# Vendor Sources capture. Required for Skroutz production capture.
# FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY

# Optional Firecrawl tuning for Skroutz capture.
# FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2
# FIRECRAWL_TIMEOUT_SECONDS=30
# ECOMMERCE_FIRECRAWL_SOURCE_REVIEW_FAILURE_THRESHOLD=2


###############################################################################
# Database/PostgreSQL
###############################################################################

# Required for DB-backed workflows. Keep credentials private if they differ from
# local defaults.
# ECOMMERCE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/ecommerce


###############################################################################
# Source URL Agent
###############################################################################

# Optional. Used by catalog update exclusions.
# CATALOG_UPDATE_EXCLUDED_MODELS_PATH=C:\path\to\codes_not_in_entersoft.csv

# Advanced/debug. Stale queued/running job thresholds.
# ECOMMERCE_CATALOG_UPDATE_STALE_RUNNING_AFTER_MINUTES=240
# ECOMMERCE_SOURCE_URL_AGENT_STALE_RUNNING_AFTER_MINUTES=240


###############################################################################
# Brave Search API
###############################################################################

# Optional Source URL Agent Brave Search API key.
# Required only when search provider brave_search is enabled.
# BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY


###############################################################################
# OpenCart
###############################################################################

# Secret/private. Required for Dashboard "Update DB" and Product Factory publish.
OPENCART_STORE_BASE="YOUR_BASE_URL"
OPENCART_ADMIN_PATH="/ADMIN/index.php"
OPENCART_ADMIN_USER="YOUR_ADMIN_USERNAME"
OPENCART_ADMIN_PASS="YOUR_ADMIN_PASSWORD"

# Required for Dashboard "Update DB" OpenCart export.
OPENCART_EXPORT_PROFILE="sourceCata"

# Optional/advanced OpenCart export settings.
# OPENCART_EXPORT_TIMEOUT_SECONDS=120
# OPENCART_EXPORT_HEADED=0

# Dashboard OpenCart Stock Sync trigger. These API endpoints trigger
# pre-existing Windows Scheduled Tasks on ERPSERVER; the sync itself runs there.
# Keep disabled unless this PC is allowed to trigger the remote tasks.
ECOMMERCE_STOCK_SYNC_ENABLED=false
ECOMMERCE_STOCK_SYNC_SERVER=ERPSERVER
ECOMMERCE_STOCK_SYNC_TASK_REVIEW=OpenCartStockSync-ReviewOnly
ECOMMERCE_STOCK_SYNC_TASK_DRY_RUN=OpenCartStockSync-DryRunImport
ECOMMERCE_STOCK_SYNC_TASK_IMPORT=OpenCartStockSync-RunImport
ECOMMERCE_STOCK_SYNC_LATEST_REVIEW_PATH=\\ERPSERVER\C$\OpenCartStockSync\runs\latest\review.json

# Required for Product Factory OpenCart CSV import.
OPENCART_IMPORT_PROFILE="product_new"

# Advanced/debug OpenCart tool settings. Usually leave unset.
# OPENCART_PIPELINE_REPO_ROOT=
# DRY_RUN=0
# HEADED=0
# PYTHON_BIN=python3
# PYTHON_SCRIPT=
# CONFIG_SCRIPT=


###############################################################################
# Catalog update
###############################################################################

# Optional. See Source URL Agent section for exclusions/stale job settings.
# CATALOG_UPDATE_EXCLUDED_MODELS_PATH=C:\path\to\codes_not_in_entersoft.csv


###############################################################################
# Product Factory API
###############################################################################

# Optional. Lets Product Factory call ecommerce source capture during prepare.
# ECOMMERCE_API_BASE_URL=http://127.0.0.1:8001

# Secret/private. Required only for OpenAI-backed authoring/LLM render stages.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_EFFORT=low

# Advanced/debug Product Factory job runner settings.
# PRODUCT_FACTORY_MAX_JOB_WORKERS=1
# PRODUCT_FACTORY_JOB_TERMINATE_TIMEOUT_SECONDS=30


###############################################################################
# Web/Vite
###############################################################################

# Browser API base URLs are usually blank in local Vite development so the
# browser uses Vite proxy paths.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_COMMERCE_API_BASE_URL=
VITE_COMMERCE_API_PROXY_TARGET=http://127.0.0.1:8001


###############################################################################
# Advanced/debug
###############################################################################

# Price Monitoring subprocess/fetch tuning.
# ECOMMERCE_MAX_FETCH_WORKERS=2
# ECOMMERCE_FETCH_STALE_AFTER_MINUTES=30
# ECOMMERCE_SUBPROCESS_TERMINATE_TIMEOUT_SECONDS=30

# Product Factory publish service sets this per job. Operators normally do not.
# CURRENT_JOB_PRODUCT_FILE=
