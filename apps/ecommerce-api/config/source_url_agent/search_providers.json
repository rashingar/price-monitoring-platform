{
  "default_provider_order": ["google_top_results"],
  "providers": {
    "google_top_results": {
      "provider_type": "google",
      "enabled": true,
      "allow_high_confidence_auto_apply": false,
      "search_url_template": "https://www.google.gr/search?q={query}&hl=el&gl=GR&num=10&pws=0",
      "max_results_per_query": 10,
      "stop_after_first_query_with_candidates": true,
      "notes": "Broad product query provider that keeps only configured-source product-shaped top Google results."
    }
  },
  "source_cascades": {}
}
