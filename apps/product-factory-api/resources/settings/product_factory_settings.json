{
  "schema_version": 1,
  "seo_health": {
    "ruleset_version": "phase1.0",
    "enforcement_mode": "blockers_only",
    "thresholds": {
      "minimum_score": 80,
      "minimum_coverage": 100,
      "blocking_failures_must_be_zero": true
    }
  },
  "identity_phase3": {
    "enabled": false,
    "families": [
      "air_conditioner"
    ],
    "mpn_require_verified": true,
    "mpn_allow_manual_override": true,
    "structured_data_artifact_enabled": true,
    "product_feed_artifact_enabled": true,
    "product_feed_identifier_mode": "mpn_only",
    "mpn_overrides": {}
  },
  "authoring": {
    "intro_text": {
      "default": {
        "min_words": 60,
        "max_words": 180,
        "max_attempts": 3,
        "max_emphasized_words_percent": 45
      },
      "by_source": {},
      "by_category": {}
    },
    "seo_meta": {
      "default": {
        "meta_description_max_chars": 255,
        "target_min_chars": 130,
        "target_max_chars": 170,
        "hard_max_chars": 180
      },
      "by_source": {},
      "by_category": {}
    }
  }
}
