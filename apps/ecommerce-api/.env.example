# Ecommerce local environment template.
# Copy this file to .env for private local development.
# Ecommerce local commands load .env automatically when present.
# Real OS environment variables override .env values.
# Do not commit .env or any file containing real credentials.

# Required PostgreSQL database for Catalog and Price Monitoring workflows.
# Bridge, CSV/file editor, paths, health, and artifact tools still work without it.
# Native Windows PostgreSQL local-development default:
ECOMMERCE_DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@127.0.0.1:5432/ecommerce

# Optional local file/path overrides. sourceCata.csv is imported into PostgreSQL
# with: python -m ecommerce.jobs.ingest_catalog
# ECOMMERCE_SOURCE_CATA_PATH=C:\path\to\sourceCata.csv
# ECOMMERCE_PRICE_IGNORE_PATH=C:\path\to\price_ignore.csv
# CATALOG_UPDATE_EXCLUDED_MODELS_PATH=C:\path\to\codes_not_in_entersoft.csv
# ECOMMERCE_CATALOG_UPDATE_STALE_RUNNING_AFTER_MINUTES=240
# ECOMMERCE_ARTIFACT_ROOTS=D:\Ecommerce\output\ecommerce\monitoring\runs
# ECOMMERCE_FILE_ROOTS=C:\Users\user\Downloads;C:\Exports;output

# Optional OpenCart catalog export profile used by Dashboard "Update DB".
# Credentials and store/admin URL must be set privately in .env or OS env.
OPENCART_STORE_BASE="YOUR_BASE_URL"
OPENCART_ADMIN_PATH="/ADMIN/index.php"
OPENCART_ADMIN_USER="YOUR_ADMIN_USERNAME"
OPENCART_ADMIN_PASS="YOUR_ADMIN_PASSWORD"

# Karapuz CSV Product Export profile name used by Playwright exporter.
OPENCART_EXPORT_PROFILE="sourceCata"
